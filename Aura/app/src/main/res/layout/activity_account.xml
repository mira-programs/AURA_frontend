<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pageColor"
    tools:context=".AccountActivity">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/top_card_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/topcard_not_filled_bg"
        android:gravity="bottom|center"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="VisualLintBounds">

        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/didact_gothic"
            android:includeFontPadding="false"
            android:text="@string/account"
            android:textColor="@color/icon_bg"
            android:textSize="45sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/usernameTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/didact_gothic"
        android:textColor="@color/icon_bg"
        android:textSize="25sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_card_layout"
        tools:text="MARIA EID" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/profile_icons_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginTop="46dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/usernameTv">

        <ImageButton
            android:id="@+id/profile_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:background="@drawable/nothing"
            android:contentDescription="@string/profile_icon"
            android:padding="16dp"
            android:scaleType="centerInside"
            android:src="@drawable/profile_icon"
            app:layout_constraintEnd_toStartOf="@id/aura_points_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/profileText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/didact_gothic"
            android:text="@string/profile"
            android:textAlignment="center"
            android:textColor="@color/icon_bg"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@id/profile_icon"
            app:layout_constraintStart_toStartOf="@id/profile_icon"
            app:layout_constraintTop_toBottomOf="@id/profile_icon" />

        <ImageButton
            android:id="@+id/aura_points_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/nothing"
            android:contentDescription="@string/aura_points_icon"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/aura_points_icon"
            app:layout_constraintEnd_toStartOf="@id/challenges_achieved_icon"
            app:layout_constraintStart_toEndOf="@id/profile_icon"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/auraPointsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/didact_gothic"
            android:text="@string/aura_points"
            android:textAlignment="center"
            android:textColor="@color/icon_bg"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@id/aura_points_icon"
            app:layout_constraintStart_toStartOf="@id/aura_points_icon"
            app:layout_constraintTop_toBottomOf="@id/aura_points_icon" />

        <ImageButton
            android:id="@+id/challenges_achieved_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/nothing"
            android:contentDescription="@string/challenges_achieved_icon"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/achieved_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/aura_points_icon"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/challengesAchievedText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/didact_gothic"
            android:text="@string/challenges_achieved"
            android:textAlignment="center"
            android:textColor="@color/icon_bg"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@id/challenges_achieved_icon"
            app:layout_constraintStart_toStartOf="@id/challenges_achieved_icon"
            app:layout_constraintTop_toBottomOf="@id/challenges_achieved_icon" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Settings List -->
    <androidx.cardview.widget.CardView
        android:id="@+id/settings_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardUseCompatPadding="true"
        app:layout_constraintBottom_toTopOf="@id/nav_fl"
        app:layout_constraintTop_toBottomOf="@id/profile_icons_row">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/settings_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:drawablePadding="8dp"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:text="@string/settings"
                android:textColor="@color/black"
                android:textSize="17sp"
                app:drawableStartCompat="@drawable/ic_settings" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#D3D3D3" />

            <TextView
                android:id="@+id/privacy_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:drawablePadding="8dp"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:text="@string/privacy"
                android:textColor="@color/black"
                android:textSize="17sp"
                app:drawableStartCompat="@drawable/ic_lock" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#D3D3D3" />

            <TextView
                android:id="@+id/help_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:drawablePadding="8dp"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:text="@string/get_help"
                android:textColor="@color/black"
                android:textSize="17sp"
                app:drawableStartCompat="@drawable/ic_help" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#D3D3D3" />

            <TextView
                android:id="@+id/about_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:drawablePadding="8dp"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:text="@string/about_aura"
                android:textColor="@color/black"
                android:textSize="17sp"
                app:drawableStartCompat="@drawable/ic_info" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#D3D3D3" />

            <TextView
                android:id="@+id/logout_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/didact_gothic"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:padding="24dp"
                android:text="@string/log_out"
                android:textColor="@color/soft_pink"
                android:textSize="17sp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Bottom Navigation -->

    <FrameLayout
        android:id="@+id/nav_fl"
        android:layout_width="850dp"
        android:layout_height="1000dp"
        android:layout_marginBottom="-895dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="@drawable/bottom_nav_bg"
            app:itemIconTint="@color/white"
            app:itemTextColor="@color/white"
            app:menu="@menu/bottom_nav_menu" />
    </FrameLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
